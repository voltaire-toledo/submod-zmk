#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/* Canonical zero-based layers from B1PRO/DESIGN/B1Pro-ZMK-KEYMAP.md. */
#define LAYER_BASE   0
#define LAYER_FN_NUM 1
#define LAYER_SYM    2
#define LAYER_NAV    3

/* Keychron launcher mouse codes, consumed by the user_custom behavior. */
#define MOUSE_UP         0x00CD
#define MOUSE_DOWN       0x00CE
#define MOUSE_LEFT       0x00CF
#define MOUSE_RIGHT      0x00D0
#define MOUSE_BUTTON_1   0x00D1
#define MOUSE_BUTTON_2   0x00D2
#define MOUSE_WHEEL_UP   0x00D9
#define MOUSE_WHEEL_DOWN 0x00DA
#define MOUSE_WHEEL_LEFT 0x00DB
#define MOUSE_WHEEL_RIGHT 0x00DC
#define MOUSE_SPEED_1    0x00DD
#define MOUSE_SPEED_2    0x00DE
#define MOUSE_SPEED_3    0x00DF

/ {
    ZMK_MACRO(en_bootloader, bindings = <&bootloader>;)

    /* Minus on Layer 1 preserves the factory three-second Boot action. */
    long_press_bootloader: long_press_bootloader {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_BOOTLOADER";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&en_bootloader>, <&none>;
    };

    /* Bilateral home-row modifiers: same-hand rolls remain letters. */
    lhm: left_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "LEFT_HOMEROW_MODS";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <
            7 8 9 10 11 12
            20 21 22 23 24 25 26
            34 35 36 37 38 39 40
            47 48 49 50 51 52 53
            60 61 62 63 64 65
            70 71 72 73 74 75
        >;
        bindings = <&kp>, <&kp>;
    };

    rhm: right_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "RIGHT_HOMEROW_MODS";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        hold-trigger-on-release;
        hold-trigger-key-positions = <
            0 1 2 3 4 5 6
            13 14 15 16 17 18 19
            27 28 29 30 31 32 33
            41 42 43 44 45 46
            54 55 56 57 58 59
            66 67 68 69
        >;
        bindings = <&kp>, <&kp>;
    };

    /* Layer 0 dual-role controls. Hold behavior is the first binding. */
    esc_caps: escape_caps_lock {
        compatible = "zmk,behavior-hold-tap";
        label = "ESC_CAPS_LOCK";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <600>;
        bindings = <&kt>, <&kp>;
    };

    fn_layer_access: fn_layer_access {
        compatible = "zmk,behavior-hold-tap";
        label = "FN_LAYER_ACCESS";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&sl>;
    };

    rshift_emoji: rshift_emoji {
        compatible = "zmk,behavior-hold-tap";
        label = "RSHIFT_EMOJI";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&kp>, <&uc>;
    };

    /* Q/W/E: single tap selects a profile; double tap starts pairing. */
    td_bt_0: td_bt_0 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_BT_0";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&bt BT_SEL 0>, <&bt BT_PAIR 0>;
    };
    td_bt_1: td_bt_1 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_BT_1";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&bt BT_SEL 1>, <&bt BT_PAIR 1>;
    };
    td_bt_2: td_bt_2 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_BT_2";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&bt BT_SEL 2>, <&bt BT_PAIR 2>;
    };

    uc: user_custom {
        compatible = "zmk,behavior-key-press";
        label = "USER_CUSTOM";
        #binding-cells = <1>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer_base {
            bindings = <
                &esc_caps CAPS ESC &kp C_BRIGHTNESS_DEC &kp C_BRIGHTNESS_INC &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_MAC_LAUNCH &kp C_AC_SEARCH &kp C_AL_LOCK &kp C_PREVIOUS &kp C_PLAY_PAUSE &kp C_NEXT &kp C_MUTE &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp DEL
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &mt LC(LS(LG(LALT))) TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &lt LAYER_NAV BSLH
                &lt LAYER_FN_NUM ESC &lhm LCTRL A &lhm LGUI S &lhm LALT D &lhm LSHFT F &lt LAYER_SYM G &lt LAYER_SYM H &rhm RSHFT J &rhm RALT K &rhm RGUI L &rhm RCTRL SEMI &kp SQT &kp RET
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &uc LCMD &uc LALT &lt LAYER_NAV SPACE &uc RCMD &fn_layer_access LAYER_FN_NUM LAYER_FN_NUM &kp LEFT &kp UP &kp DOWN &kp RIGHT
                &mo LAYER_FN_NUM &out OUT_BLE &out OUT_24G &out OUT_CHG &out OUT_CHGD
            >;
        };

        layer_fn_num {
            bindings = <
                &to LAYER_BASE &kp C_BRIGHTNESS_INC &kp C_BRIGHTNESS_DEC &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_MAC_LAUNCH &uc LA(SPACE) &kp C_AL_LOCK &uc LG(LS(N4)) &kp C_PLAY_PAUSE &kp C_AC_SEARCH &kp C_MUTE &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp DEL
                &trans &to LAYER_FN_NUM &to LAYER_SYM &to LAYER_NAV &out OUT_24G &trans &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS &kp KP_PLUS &trans &long_press_bootloader 0 0 &trans &trans
                &trans &td_bt_0 0 &td_bt_1 0 &td_bt_2 0 &trans &kp DEL &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp BSPC &trans &trans &trans &uc LG(LS(N4))
                &trans &kp LCTRL &kp LGUI &kp LALT &kp LSHFT &trans &kp TAB &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp RET &trans &trans
                &trans &trans &trans &trans &trans &kp COMMA &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DOT &kp FSLH &rshift_emoji RSHFT LC(LG(SPACE))
                &kp LCTRL &uc LCMD &uc LALT &kp KP_N0 &uc RCMD &trans &kp HOME &kp PG_UP &kp PG_DN &kp END
                &none &none &none &none &none
            >;
        };

        layer_sym {
            bindings = <
                &to LAYER_BASE &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &uc LC(MINUS) &uc LC(EQUAL) &uc LC(N0)
                &trans &trans &trans &kp HASH &uc MOUSE_WHEEL_DOWN &trans &trans &trans &trans &trans &uc MOUSE_BUTTON_1 &uc MOUSE_UP &uc MOUSE_BUTTON_2 &trans
                &kp GRAVE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTERISK &kp MINUS &kp UNDER &kp PLUS &kp RBRC &kp PIPE
                &trans &kp EQUAL &kp LBKT &kp LBRC &kp LPAR &trans &trans &kp RPAR &kp RBRC &kp RBKT &kp COLON &kp DQT &kp EQUAL
                &trans &trans &trans &trans &trans &trans &trans &trans &kp LT &kp GT &kp QMARK &kp RSHFT
                &trans &trans &trans &trans &trans &trans &kp LEFT &kp UP &kp DOWN &kp RIGHT
                &none &none &none &none &none
            >;
        };

        layer_nav {
            bindings = <
                &to LAYER_BASE &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &kp F18 &kp F19 &kp F20 &kp F21 &kp F22 &kp F23 &kp F24 &trans
                &trans &trans &trans &kp HASH &uc MOUSE_WHEEL_DOWN &trans &trans &trans &trans &trans &uc MOUSE_BUTTON_1 &uc MOUSE_UP &uc MOUSE_BUTTON_2 &trans
                &trans &uc LA(F4) &uc LC(W) &uc MOUSE_WHEEL_LEFT &uc MOUSE_WHEEL_UP &uc MOUSE_WHEEL_RIGHT &uc LC(Y) &kp DEL &kp UP &kp BSPC &uc MOUSE_LEFT &uc MOUSE_DOWN &uc MOUSE_RIGHT &trans
                &trans &kp LCTRL &kp LGUI &kp LALT &kp LSHFT &trans &kp HOME &kp LEFT &kp DOWN &kp RIGHT &kp END &trans &trans
                &trans &trans &uc LC(X) &uc LC(C) &uc LC(V) &uc LC(B) &kp PG_UP &kp PG_DN &trans &trans &trans &trans
                &uc MOUSE_SPEED_1 &uc MOUSE_SPEED_2 &uc MOUSE_SPEED_3 &trans &trans &trans &kp LEFT &kp UP &kp DOWN &kp RIGHT
                &none &none &none &none &none
            >;
        };
    };
};
