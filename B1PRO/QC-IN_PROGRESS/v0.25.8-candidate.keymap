/* Keychron B1 Pro v0.25.8 candidate.
 * Baseline: v0.25-unified (recalled).
 *
 * What's New
 * - Reduces the keymap from 12 layers to 8: Mac layers remain 0--3 and
 *   Windows layers are renumbered from 6--9 to 4--7. The inert UAT layers
 *   and Macro/selector layers are removed.
 * - Removes the unused standalone long_press_change behavior.
 *
 * Base Layers
 * - The Fn key tap dances now use their second and third taps to toggle the
 *   matching Symbol and Navigation layers; they no longer select Macro layers.
 * - Z and / are ordinary base-layer keys; holding either no longer accesses a
 *   Macro layer.
 * - Home-row modifiers add retro-tap and increase tapping-term, quick-tap, and
 *   prior-idle timings by 75 ms (to 275, 250, and 225 ms, respectively).
 *   Their opposite-hand trigger-position lists are also updated.
 *
 * Function Layers
 * - Bluetooth profile keys now tap to pair and require a 4-second hold to
 *   select the saved profile; they replace the former 350-ms select/pair
 *   tap dances.
 * - The former 2.4 GHz output binding is transparent. Battery status is bound
 *   directly to B on both Function layers instead of through the removed combo.
 * - Windows Function V sends Win+Ctrl+Shift+B. Windows Function Esc returns to
 *   the renumbered Windows Base layer (4 instead of 6).
 *
 * Symbol Layers
 * - Three formerly transparent Symbol bindings now send |, :, and ".
 * - Comma tap/double-tap sends < / <>; Period tap/double-tap sends > / </>.
 *   This replaces the single former angle-bracket tap dance.
 *
 * Navigation Layers
 * - The Space and Slash positions are transparent, allowing their lower-layer
 *   bindings through instead of the previous inert Space and OS-specific Slash
 *   shortcuts.
 *
 * LED
 * - This keymap changes no LED-controller configuration. Its battery-status
 *   binding remains &out OUT_BAT, now attached directly to Function-layer B.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define LYR_M_BASE        0
#define LYR_M_FUNC        1
#define LYR_M_SYM1        2
#define LYR_M_NAV1        3
#define LYR_W_BASE        4
#define LYR_W_FUNC        5
#define LYR_W_SYM1        6
#define LYR_W_NAV1        7

#define MOUSE_UP          0x00CD
#define MOUSE_DOWN        0x00CE
#define MOUSE_LEFT        0x00CF
#define MOUSE_RIGHT       0x00D0
#define MOUSE_BUTTON_1    0x00D1
#define MOUSE_BUTTON_2    0x00D2
#define MOUSE_WHEEL_UP    0x00D9
#define MOUSE_WHEEL_DOWN  0x00DA
#define MOUSE_WHEEL_LEFT  0x00DB
#define MOUSE_WHEEL_RIGHT 0x00DC
#define MOUSE_SPEED_1     0x00DD
#define MOUSE_SPEED_2     0x00DE
#define MOUSE_SPEED_3     0x00DF

/ {
    ZMK_MACRO(recover, bindings = <&out OUT_RECOVER>;)
    ZMK_MACRO(change, bindings = <&out OUT_FN>;)
    ZMK_MACRO(fn_win, bindings = <&out OUT_FN_WIN>;)
    ZMK_MACRO(en_bootloader, bindings = <&bootloader>;)
    ZMK_MACRO(mcro_parens, bindings = <&kp LPAR &kp RPAR &kp LEFT>;)
    ZMK_MACRO(mcro_braces, bindings = <&kp LBRC &kp RBRC &kp LEFT>;)
    ZMK_MACRO(mcro_brackets, bindings = <&kp LBKT &kp RBKT &kp LEFT>;)
    ZMK_MACRO(mcro_angle_brackets, bindings = <&kp LT &kp GT &kp LEFT>;)
    ZMK_MACRO(mcro_angle_brackets_slash, bindings = <&kp LT &kp FSLH &kp GT &kp LEFT>;)

    /*
     * Factory Reset Hold-Tap (3-second guard):
     * Invokes &recover (&out OUT_RECOVER -> zmk_factory_recover()).
     * Erases stored Bluetooth bonds from NVS, deletes dynamic VIA/EEPROM overrides,
     * resets internal runtime flags (e.g. fn_exchange), flashes recovery LED,
     * and restarts the MCU back into the compiled v0.25 candidate baseline.
     */
    long_press_recover: long_press_recover {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_RECOVER";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&recover>, <&none>;
    };

    /*
     * Windows Key Lock Hold-Tap (3-second guard):
     * Invokes &fn_win (&out OUT_FN_WIN -> toggles fn_win_lock flag).
     * When active, hid.c filters out LGUI/RGUI modifier signals globally across
     * all Windows layers (Base 4, Sym 6, Nav 7) to prevent accidental
     * Win+L, Win+U, or gaming interruptions.
     */
    long_press_fn_win: long_press_fn_win {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_FN_WIN";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&fn_win>, <&none>;
    };

    /*
     * Fn + Esc dual-role bindings for Function layers (pos 0):
     * - Tap: Instantly exits Function layer back to Base (Layer 0 Mac / Layer 4 Win).
     * - Hold (3s): Toggles Function/Media row exchange (&change / OUT_FN).
     */
    fn_esc_change_mac: fn_esc_change_mac {
        compatible = "zmk,behavior-hold-tap";
        label = "FN_ESC_CHANGE_MAC";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&change>, <&to>;
    };

    fn_esc_change_win: fn_esc_change_win {
        compatible = "zmk,behavior-hold-tap";
        label = "FN_ESC_CHANGE_WIN";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;
        bindings = <&change>, <&to>;
    };

    long_press_bootloader: long_press_bootloader {
        compatible = "zmk,behavior-hold-tap";
        label = "LP_BOOTLOADER";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&en_bootloader>, <&none>;
    };

    esc_caps: escape_caps_lock {
        compatible = "zmk,behavior-hold-tap";
        label = "ESC_CAPS_LOCK";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <600>;
        // Use an ordinary press/release for the hold. &kt keeps CLCK down
        // across physical releases, which requires a second hold to finish.
        bindings = <&kp>, <&kp>;
    };

    ht_fn_mac: ht_fn_mac {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_FN_MAC";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&tog>;
    };

    td_fn_mac: td_fn_mac {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_FN_MAC";
        #binding-cells = <1>;
        tapping-term-ms = <250>;
        bindings = <&ht_fn_mac LYR_M_FUNC LYR_M_FUNC>, <&tog LYR_M_SYM1>, <&tog LYR_M_NAV1>;
    };

    ht_fn_win: ht_fn_win {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_FN_WIN";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&mo>, <&tog>;
    };

    td_fn_win: td_fn_win {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_FN_WIN";
        #binding-cells = <1>;
        tapping-term-ms = <250>;
        bindings = <&ht_fn_win LYR_W_FUNC LYR_W_FUNC>, <&tog LYR_W_SYM1>, <&tog LYR_W_NAV1>;
    };

    ZMK_MACRO(bt_pair0, bindings = <&bt BT_PAIR 0>;)
    ZMK_MACRO(bt_pair1, bindings = <&bt BT_PAIR 1>;)
    ZMK_MACRO(bt_pair2, bindings = <&bt BT_PAIR 2>;)
    ZMK_MACRO(bt_recon_0, bindings = <&bt BT_SEL 0>;)
    ZMK_MACRO(bt_recon_1, bindings = <&bt BT_SEL 1>;)
    ZMK_MACRO(bt_recon_2, bindings = <&bt BT_SEL 2>;)

    ht_bt_0: ht_bt_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_BT_0";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <4000>;
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };

    ht_bt_1: ht_bt_1 {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_BT_1";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <4000>;
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };

    ht_bt_2: ht_bt_2 {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_BT_2";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <4000>;
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };

    td_sym_parens: td_sym_parens {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_PARENS";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp RPAR>, <&mcro_parens>;
    };

    td_sym_braces: td_sym_braces {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_BRACES";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp RBRC>, <&mcro_braces>;
    };

    td_sym_brackets: td_sym_brackets {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_BRACKETS";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp RBKT>, <&mcro_brackets>;
    };

    td_sym_angle_brackets_comma: td_sym_angle_brackets_comma {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_ANGLE_BRACKETS_COMMA";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp LT>, <&mcro_angle_brackets>;
    };

    td_sym_angle_brackets_period: td_sym_angle_brackets_period {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_SYM_ANGLE_BRACKETS_PERIOD";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&kp GT>, <&mcro_angle_brackets_slash>;
    };

    td_nav_c_mac: td_nav_c_mac {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_NAV_C_MAC";
        #binding-cells = <1>;
        tapping-term-ms = <200>;
        bindings = <&uc LG(C)>, <&uc LG(LS(C))>, <&uc LC(LS(C))>;
    };

    td_nav_v_mac: td_nav_v_mac {
        compatible = "zmk,behavior-tap-dance";
        label = "TD_NAV_V_MAC";
        #binding-cells = <1>;
        tapping-term-ms = <200>;
        bindings = <&uc LG(V)>, <&uc LC(V)>, <&uc LC(LS(V))>;
    };

    lhm: left_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "LEFT_HOMEROW_MODS";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <275>;
        quick-tap-ms = <250>;
        require-prior-idle-ms = <225>;
        retro-tap;
        hold-trigger-on-release;
        hold-trigger-key-positions = <
            7 8 9 10 11 12 13
            21 22 23 24 25 26 27
            35 36 37 38 39 40 41
            48 49 50 51 52 53 54
            61 62 63 64 65 66
            71 72 73 74 75 76
        >;
        bindings = <&kp>, <&kp>;
    };

    rhm: right_homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "RIGHT_HOMEROW_MODS";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <275>;
        quick-tap-ms = <250>;
        require-prior-idle-ms = <225>;
        retro-tap;
        hold-trigger-on-release;
        hold-trigger-key-positions = <
            0 1 2 3 4 5 6
            14 15 16 17 18 19 20
            28 29 30 31 32 33 34
            42 43 44 45 46 47
            55 56 57 58 59 60
            67 68 69 70
        >;
        bindings = <&kp>, <&kp>;
    };


    uc: user_custom {
        compatible = "zmk,behavior-key-press";
        label = "USER_CUSTOM";
        #binding-cells = <1>;
    };

    combos {
        compatible = "zmk,combos";

        combo_jz_reset {
        /*
         * Factory Reset Chord (Fn + J + Z held for 3 seconds):
         * - Scoped strictly to Function layers (<LYR_M_FUNC LYR_W_FUNC>), leaving
         *   individual J and Z keys completely unrestricted across Base and other layers.
         * - Simultaneous chord of J (pos 49) + Z (pos 56) with 3000ms hold guard.
         * - Executes zmk_factory_recover(): wipes all paired Bluetooth bonds in NVS,
         *   erases dynamic VIA/EEPROM customizations, resets internal flags, flashes
         *   recovery LED, and restarts the keyboard into the compiled v0.25 baseline.
         */
            timeout-ms = <1000>;
            layers = <LYR_M_FUNC LYR_W_FUNC>;
            key-positions = <49 56>; /* J (49), Z (56) */
            bindings = <&long_press_recover 0 0>;
        };

        combo_win_lock {
        /*
         * Windows Key Lock (Fn + Win held for 3 seconds):
         * - Toggle trigger scoped to Windows Function layer (<LYR_W_FUNC>) at pos 68.
         * - Once toggled ON, the lock operates globally across all Windows layers
         *   (Base 4, Sym 6, Nav 7) by having hid.c suppress LGUI/RGUI signals,
         *   preventing accidental Win+L (Lock Screen), Win+U (Accessibility), or gaming interruptions.
         * - Visual confirmation: triggers a unique Magenta/Purple double-flash LED indication.
         * - Toggling again turns the lock off.
         */
            timeout-ms = <1000>;
            layers = <LYR_W_FUNC>;
            key-positions = <68>;    /* Win/Alt (68) */
            bindings = <&long_press_fn_win 0 0>;
        };
    };

    keymap {

    /*
                              ..'
                      ,xNMM.
                    .OMMMMo
                    lMM"
          .;loddo:.  .olloddol;.
        cKMMMMMMMMMMNWMMMMMMMMMM0:
      .KMMMMMMMMMMMMMMMMMMMMMMMWd.
      XMMMMMMMMMMMMMMMMMMMMMMMX.
      ;MMMMMMMMMMMMMMMMMMMMMMMM:
      :MMMMMMMMMMMMMMMMMMMMMMMM:
      .MMMMMMMMMMMMMMMMMMMMMMMMX.
      kMMMMMMMMMMMMMMMMMMMMMMMMWd.
      'XMMMMMMMMMMMMMMMMMMMMMMMMMMk
        'XMMMMMMMMMMMMMMMMMMMMMMMMK.
          kMMMMMMMMMMMMMMMMMMMMMMd
          ;KMMMMMMMWXXWMMMMMMMk.
            "cooc*"    "*coo'"
                                      */
    compatible = "zmk,keymap";
    /* LAYER 0: LYR_M_BASE
    ┏━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓
    ┃           ┃         ┃         ┃ MISSION ┃   MAC   ┃  SEARCH ┃         ┃ PREVIOUS┃ PLAY/   ┃   NEXT  ┃   Vol   ┃         ┃         ┃         ┃
    ┃TAP: ESC   ┃ Bright- ┃ Bright+ ┃ CONTROL ┃ LAUNCH  ┃ SEARCH  ┃  LOCK   ┃  PREV   ┃  PAUSE  ┃  NEXT   ┃   Mute  ┃   Vol-  ┃  Vol+   ┃   DEL   ┃
    ┃HOLD: CAPS ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃
    ┣━━━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━┳━━━┻━━━━━━━━━┫
    ┃   ~   ┃    !    ┃    @    ┃    #    ┃    $    ┃    %    ┃    ^    ┃    *    ┃    -    ┃    (    ┃    )    ┃    _    ┃    +    ┃             ┃
    ┃   `   ┃    1    ┃    2    ┃    3    ┃    4    ┃    5    ┃    6    ┃    7    ┃    8    ┃    9    ┃    0    ┃    -    ┃    =    ┃    BKSP     ┃
    ┃       ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃             ┃
    ┣━━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━━━━━┫
    ┃TAP: TAB  ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃    {    ┃    }    ┃          ┃
    ┃HOLD: HYPR┃    Q    ┃    W    ┃    E    ┃    R    ┃    T    ┃    Y    ┃    U    ┃    I    ┃    O    ┃    P    ┃    [    ┃    ]    ┃TAP: \    ┃ 
    ┃          ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃HOLD:MO(3)┃
    ┣━━━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻┳━━━━━━━━┻━━━━━━━━━━┫
    ┃TAP=ESC    ┃ TAP=A   ┃ TAP=S   ┃ TAP=D   ┃ TAP=F   ┃ TAP=G   ┃ TAP=H   ┃ TAP=J   ┃ TAP=K   ┃ TAP=L   ┃ TAP=;/: ┃    "    ┃                   ┃
    ┃HOLD:MO(1) ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃ HLD=    ┃    '    ┃      RETURN       ┃
    ┃           ┃  L_CTRL ┃  L_GUI  ┃  L_ALT  ┃ L_SHIFT ┃   MO(2) ┃   MO(2) ┃ R_SHIFT ┃  R_ALT  ┃  R_GUI  ┃  R_CTRL ┃         ┃                   ┃
    ┣━━━━━━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━━━━━━━━━━━━━━━━━━┫
    ┃              ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃    <    ┃    >    ┃    ?    ┃                          ┃
    ┃   L_SHIFT    ┃    Z    ┃    X    ┃    C    ┃    V    ┃    B    ┃   N     ┃    M    ┃    ,    ┃    .    ┃    /    ┃        R_SHIFT           ┃
    ┃              ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃                          ┃
    ┣━━━━━━━━━━━┳━━┻━━━━━━━┳━┻━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━┻━━━━┳━━━━┻━━━━━┳━┳━┻━━━━━━┳━━━━━━━━━┳━━━━━━━━━┫
    ┃           ┃          ┃           ┃                                                 ┃              ┃1T/H: FUNC┃ ┃        ┃    ↑    ┃         ┃
    ┃  L_CTRL   ┃  L_ALT   ┃   L_CMD   ┃             * &lt LYR_M_NAV1 SPACE *            ┃    R_CMD     ┃2T: SYM1  ┃ ┃    ←   ┣━━━━━━━━━┫   →     ┃
    ┃           ┃          ┃           ┃                                                 ┃              ┃3T: NAV1  ┃ ┃        ┃    ↓    ┃         ┃
