        &kp GRAVE       &kp EXCL   &kp AT    &kp HASH  &kp DLLR   &kp PRCNT  &kp CARET  &kp AMPS                  &kp ASTERISK      &kp MINUS         &kp EQUAL          &trans            &trans    &kp PIPE
        &kp TILDE       &lhm LCTRL LT &lhm   LGUI LBKT &lhm LALT  LBRC &lhm  LSHFT LPAR &none &none               &td_sym_parens 0  &td_sym_braces 0  &td_sym_brackets 0 &kp COLON            &kp DQT    &kp EQUAL
        &trans          &trans     &trans    &trans    &trans     &trans     &trans     &trans  &td_sym_angle_brackets_comma 0    &td_sym_angle_brackets_period 0            &kp QMARK          &uc LC(LG(SPACE)) //SHIFTx2
        &trans          &trans     &trans    &trans    &trans     &trans     &kp LEFT   &kp UP            &kp DOWN          &kp RIGHT
        &none           &none      &none     &none     &none
      >;
    };

    /* LAYER 3: LYR_M_NAV1
    ┏━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓
    ┃           ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃
    ┃   TO(0)   ┃   F13   ┃   F14   ┃   F15   ┃   F16   ┃   F17   ┃   F18   ┃   F19   ┃   F20   ┃   F21   ┃   F22   ┃   F23   ┃   F24   ┃   ▼     ┃
