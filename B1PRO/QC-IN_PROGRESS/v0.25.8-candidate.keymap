    ┃           ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃         ┃                   ┃
    ┣━━━━━━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━┳━━━━━━┻━━━━━━━━━━━━━━━━━━━┫
    ┃              ┃         ┃         ┃1T:LG(C) ┃1T:LG(V) ┃         ┃         ┃         ┃         ┃         ┃         ┃                          ┃
    ┃       ▼      ┃  LG(Z)  ┃  LG(X)  ┃2T:LGS(C)┃2T:LC(V) ┃  LG(B)  ┃  PgUp   ┃  PdDn   ┃LGS(TAB) ┃ LG(TAB) ┃ LGS(/)  ┃            ▼             ┃
    ┃              ┃         ┃         ┃3T:LCS(C)┃3T:LCS(V)┃         ┃         ┃         ┃         ┃         ┃         ┃                          ┃
    ┣━━━━━━━━━━━┳━━┻━━━━━━━┳━┻━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━┻━━━━┳━━━━┻━━━━━┳━┳━┻━━━━━━┳━━━━━━━━━┳━━━━━━━━━┫
    ┃           ┃          ┃           ┃                                                 ┃              ┃          ┃ ┃        ┃    ↑    ┃         ┃
    ┃   MSPD1   ┃   MSPD2  ┃   MSPD3   ┃                    * IN USE *                   ┃       ▼      ┃     ▼    ┃ ┃    ←   ┣━━━━━━━━━┫   →     ┃
    ┃           ┃          ┃           ┃                                                 ┃              ┃          ┃ ┃        ┃    ↓    ┃         ┃
    ┗━━━━━━━━━━━┻━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━┻━━━━━━━━━━┛ ┗━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
    */
    layer_m_nav1 {
      bindings = <
        //ESC              //f1               //f2              //f3                  //f4                //f5                   //f6       //f7       //f8             //f9         //f10               //f11           //f12               //DEL
        &to LYR_M_BASE     &kp F13            &kp F14           &kp F15               &kp F16             &kp F17                &kp F18    &kp F19    &kp F20          &kp F21      &kp F22             &kp F23         &kp F24             &trans
        &trans             &trans              &trans           &kp HASH              &trans              &uc MOUSE_WHEEL_DOWN   &trans      &trans    &kp SPACE        &trans       &uc MOUSE_BUTTON_1  &uc MOUSE_UP    &uc MOUSE_BUTTON_2  &trans
        &trans             &uc LG(Q)          &uc LG(W)         &uc MOUSE_WHEEL_LEFT  &uc MOUSE_WHEEL_UP  &uc MOUSE_WHEEL_RIGHT  &uc LG(Y)  &kp DEL    &kp UP           &kp BSPC     &uc MOUSE_LEFT      &uc MOUSE_DOWN  &uc MOUSE_RIGHT     &trans
        &trans             &kp LCTRL          &kp LGUI          &kp LALT              &kp LSHFT           &kp SPACE              &kp HOME   &kp LEFT   &kp DOWN         &kp RIGHT    &kp END             &trans           &trans
        &trans             &uc LG(Z)          &uc LG(X)         &td_nav_c_mac 0       &td_nav_v_mac 0     &uc LG(B)              &kp PG_UP  &kp PG_DN  &uc LC(LS(TAB))  &uc LC(TAB)  &trans              &trans
        &uc MOUSE_SPEED_1  &uc MOUSE_SPEED_2  &uc MOUSE_SPEED_3                       &trans              &trans                 &trans     &kp LEFT   &kp UP           &kp DOWN     &kp RIGHT
        &none              &none              &none             &none                 &none
    >;
    };

